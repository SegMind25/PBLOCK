# Server Configuration
SERVER_HOST=127.0.0.1
SERVER_PORT=8080
RUST_LOG=info

# Database
DATABASE_URL=sqlite://web_guardian.db?mode=rwc

# Security
JWT_SECRET=CHANGE_THIS_TO_A_SECURE_RANDOM_STRING_AT_LEAST_32_CHARS
JWT_EXPIRATION_HOURS=24
ENCRYPTION_KEY=CHANGE_THIS_TO_A_SECURE_32_BYTE_HEX_STRING

# Application
APP_NAME=Web Guardian
ADMIN_SETUP_REQUIRED=true

# Filtering
ENABLE_DNS_FILTERING=true
ENABLE_HOST_FILE_BLOCKING=true
BLOCK_LIST_UPDATE_HOURS=24

# Process Protection
ENABLE_TAMPER_PROTECTION=true
MONITOR_INTERVAL_SECONDS=5
```

And the **backend/.gitignore**:
```
# Rust
/target/
**/*.rs.bk
*.pdb
Cargo.lock

# Database
*.db
*.db-shm
*.db-wal

# Environment
.env

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Logs
*.log

# Build
/dist/
/release/