<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/screenBg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="24dp"
        android:paddingBottom="32dp">

        <!-- Top bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/brand"
                android:textColor="@color/textMain"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/lockPill"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_pill"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:text="@string/pill_unlocked"
                android:textColor="@color/textSub"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Hero status card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_card"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="22dp">

            <FrameLayout
                android:id="@+id/heroRing"
                android:layout_width="132dp"
                android:layout_height="132dp"
                android:background="@drawable/bg_hero_off">

                <ImageView
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:layout_gravity="center"
                    android:contentDescription="@string/app_name"
                    android:src="@drawable/ic_shield_white" />
            </FrameLayout>

            <TextView
                android:id="@+id/heroTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/hero_off_title"
                android:textColor="@color/textMain"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/heroSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:lineSpacingExtra="2dp"
                android:text="@string/hero_off_sub"
                android:textColor="@color/textSub"
                android:textSize="14sp" />

            <Button
                android:id="@+id/vpnButton"
                style="@style/PB.Button.Success"
                android:layout_marginTop="18dp"
                android:text="@string/btn_vpn_enable" />

            <Button
                android:id="@+id/blockButton"
                style="@style/PB.Button.Success"
                android:layout_marginTop="18dp"
                android:text="@string/btn_block_root"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Stats -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:paddingTop="14dp"
                android:paddingBottom="14dp">

                <TextView
                    android:id="@+id/streakValue"
                    style="@style/PB.StatValue"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="0" />

                <TextView
                    style="@style/PB.StatLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/stat_days" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:paddingTop="14dp"
                android:paddingBottom="14dp">

                <TextView
                    android:id="@+id/domainsValue"
                    style="@style/PB.StatValue"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="-" />

                <TextView
                    style="@style/PB.StatLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/stat_sites" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:paddingTop="14dp"
                android:paddingBottom="14dp">

                <TextView
                    android:id="@+id/safeSearchValue"
                    style="@style/PB.StatValue"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/stat_off" />

                <TextView
                    style="@style/PB.StatLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/stat_safesearch" />
            </LinearLayout>
        </LinearLayout>

        <!-- Urge help -->
        <Button
            android:id="@+id/urgeButton"
            style="@style/PB.Button.Primary"
            android:layout_marginTop="12dp"
            android:text="@string/btn_urge" />

        <TextView
            android:id="@+id/quoteText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:lineSpacingExtra="3dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:textColor="@color/textSub"
            android:textSize="13sp"
            android:textStyle="italic" />

        <!-- Setup checklist -->
        <TextView
            style="@style/PB.SectionTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/section_setup" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp">

            <TextView
                android:id="@+id/stepPassword"
                style="@style/PB.Step"
                android:drawableStart="@drawable/ic_step_todo"
                android:text="@string/step_password" />

            <TextView
                android:id="@+id/stepFilter"
                style="@style/PB.Step"
                android:drawableStart="@drawable/ic_step_todo"
                android:text="@string/step_filter" />

            <TextView
                android:id="@+id/stepShield"
                style="@style/PB.Step"
                android:drawableStart="@drawable/ic_step_todo"
                android:text="@string/step_shield" />

            <TextView
                android:id="@+id/stepLock"
                style="@style/PB.Step"
                android:drawableStart="@drawable/ic_step_todo"
                android:text="@string/step_lock" />
        </LinearLayout>

        <!-- Password -->
        <TextView
            style="@style/PB.SectionTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/section_password" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="16dp">

            <EditText
                android:id="@+id/passwordInput"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/bg_edittext"
                android:hint="@string/password_hint"
                android:importantForAutofill="no"
                android:inputType="textPassword"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:textColor="@color/textMain"
                android:textColorHint="@color/textSub"
                android:textSize="15sp" />

            <Button
                android:id="@+id/setupButton"
                style="@style/PB.Button.Secondary"
                android:text="@string/btn_set_password" />
        </LinearLayout>

        <!-- Advanced -->
        <TextView
            android:id="@+id/advancedToggle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="?android:attr/selectableItemBackground"
            android:padding="8dp"
            android:text="@string/advanced_show"
            android:textColor="@color/textSub"
            android:textSize="13sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/advancedContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="16dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/statusText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:text="@string/loading"
                android:textColor="@color/textSub"
                android:textSize="12sp" />

            <Button
                android:id="@+id/statusButton"
                style="@style/PB.Button.Secondary"
                android:layout_marginTop="14dp"
                android:text="@string/btn_status" />

            <Button
                android:id="@+id/deviceAdminButton"
                style="@style/PB.Button.Secondary"
                android:text="@string/btn_device_admin" />

            <TextView
                android:id="@+id/deviceAdminWarning"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="8dp"
                android:text="@string/device_admin_warning"
                android:textColor="@color/danger"
                android:textSize="12sp"
                android:visibility="gone" />

            <Button
                android:id="@+id/unblockButton"
                style="@style/PB.Button.Danger"
                android:text="@string/btn_unblock_root"
                android:visibility="gone" />

            <Button
                android:id="@+id/consoleButton"
                style="@style/PB.Button.Secondary"
                android:text="@string/btn_console"
                android:visibility="gone" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="center"
            android:text="@string/copyright"
            android:textColor="#4A5372"
            android:textSize="11sp" />
    </LinearLayout>
</ScrollView>
