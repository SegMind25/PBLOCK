<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0D1117">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="#161B22"
        android:paddingStart="16dp"
        android:paddingEnd="8dp">

        <TextView
            android:id="@+id/consoleBack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="← Back"
            android:textColor="#58A6FF"
            android:textSize="15sp"
            android:padding="8dp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="ROOT CONSOLE"
            android:textColor="#33FF66"
            android:textSize="16sp"
            android:textStyle="bold"
            android:fontFamily="monospace"
            android:gravity="center" />

        <View
            android:layout_width="52dp"
            android:layout_height="1dp" />
    </LinearLayout>

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#161B22"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="6dp">

            <Button
                android:id="@+id/quickStart"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:minWidth="0dp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="▶ Start Blocking"
                android:textAllCaps="false"
                android:textSize="12sp"
                android:backgroundTint="#238636" />

            <Button
                android:id="@+id/quickStop"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:minWidth="0dp"
                android:layout_marginStart="6dp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="■ Stop Blocking"
                android:textAllCaps="false"
                android:textSize="12sp"
                android:backgroundTint="#DA3633" />

            <Button
                android:id="@+id/quickStatus"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:minWidth="0dp"
                android:layout_marginStart="6dp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="Status"
                android:textAllCaps="false"
                android:textSize="12sp"
                android:backgroundTint="#1F6FEB" />

            <Button
                android:id="@+id/quickId"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:minWidth="0dp"
                android:layout_marginStart="6dp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="id"
                android:textAllCaps="false"
                android:textSize="12sp"
                android:backgroundTint="#30363D" />

            <Button
                android:id="@+id/quickClear"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:minWidth="0dp"
                android:layout_marginStart="6dp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="Clear"
                android:textAllCaps="false"
                android:textSize="12sp"
                android:backgroundTint="#30363D" />
        </LinearLayout>
    </HorizontalScrollView>

    <ScrollView
        android:id="@+id/consoleScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="10dp">

        <TextView
            android:id="@+id/consoleOutput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:textColor="#33FF66"
            android:textSize="12sp" />
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="#161B22"
        android:padding="8dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="# "
            android:textColor="#33FF66"
            android:fontFamily="monospace"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/consoleInput"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:hint="type command..."
            android:textColorHint="#555555"
            android:textColor="#FFFFFF"
            android:background="#21262D"
            android:fontFamily="monospace"
            android:textSize="13sp"
            android:imeOptions="actionSend"
            android:inputType="text"
            android:maxLines="1"
            android:paddingStart="10dp"
            android:paddingEnd="10dp" />

        <Button
            android:id="@+id/consoleRun"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_marginStart="6dp"
            android:minWidth="0dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:text="Run"
            android:textAllCaps="false"
            android:backgroundTint="#238636" />
    </LinearLayout>
</LinearLayout>
