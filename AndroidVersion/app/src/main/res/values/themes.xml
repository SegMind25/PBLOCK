<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="PBlockTheme" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
        <item name="android:statusBarColor">@color/colorPrimaryDark</item>
        <item name="android:navigationBarColor">@color/colorPrimaryDark</item>
        <item name="android:windowBackground">@color/screenBg</item>
    </style>

    <style name="UninstallProtectionTheme" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowFullscreen">true</item>
        <item name="android:statusBarColor">#0F0F23</item>
        <item name="android:navigationBarColor">#0F0F23</item>
        <item name="android:windowBackground">#0F0F23</item>
    </style>
</resources>
